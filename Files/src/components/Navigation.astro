---
import Icon from './Icon.astro';
import ChapterIndex from './ChapterIndex.astro';
import { site } from '../data/site';
const socials = [{name:'Email',icon:'mail',href:`mailto:${site.email}`},{name:'Instagram',icon:'instagram',href:site.instagram},{name:'Publications',icon:'paper',href:site.publications}];
---
<a class="skip-link" href="#work">Skip to thesis studies</a>
<header class="site-header">
  <a class="wordmark" href="#top" aria-label="ACI — back to beginning">{site.name}<span class="wordmark-dot">°</span></a>
  <nav aria-label="Main navigation">{[{label:'Studies',id:'work'},{label:'Research',id:'research'},{label:'Team',id:'about'},{label:'Contact',id:'contact'}].map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav>
</header>
<aside class="social-rail" aria-label="Connect with ACI">
  {socials.map(link => <a href={link.href} aria-label={link.name} target={link.href.startsWith('https') ? '_blank' : undefined} rel={link.href.startsWith('https') ? 'noopener noreferrer' : undefined}><Icon name={link.icon}/><span class="tooltip">{link.name}</span></a>)}
</aside>

<ChapterIndex />
